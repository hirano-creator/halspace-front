{
  "name": "partsgate",
  "private": true,
  "description": "PARTS GATE — バーコード部品照合・出荷確認システム",
  "workspaces": [
    "shared",
    "api",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "db:migrate:local": "npm run db:migrate:local -w api",
    "db:seed:local": "npm run db:seed:local -w api",
    "db:reset:local": "npm run db:reset:local -w api",
    "typecheck": "tsc -p shared --noEmit && tsc -p api --noEmit && tsc -p web --noEmit",
    "test": "npm run test -w shared && npm run test -w api",
    "build": "npm run build -w web",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module"
}
