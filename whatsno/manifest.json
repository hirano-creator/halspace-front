{
  "name": "What'sNo",
  "short_name": "What'sNo",
  "description": "製造業向けクラウドストレージ",
  "start_url": "/whatsno/app/dashboard.html?source=pwa",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#1E3A5F",
  "theme_color": "#1E3A5F",
  "icons": [
    {
      "src": "/whatsno/assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/whatsno/assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "categories": ["business", "productivity"],
  "lang": "ja",
  "file_handlers": [
    {
      "action": "/whatsno/app/save.html?source=filehandler",
      "launch_type": "single-client",
      "accept": {
        "application/pdf": [".pdf"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/png": [".png"],
        "image/gif": [".gif"],
        "image/webp": [".webp"],
        "image/bmp": [".bmp"],
        "image/tiff": [".tif", ".tiff"],
        "image/heic": [".heic"],
        "image/heif": [".heif"],
        "image/svg+xml": [".svg"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"],
        "application/vnd.ms-excel": [".xls"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
        "application/msword": [".doc"],
        "application/vnd.openxmlformats-officedocument.presentationml.presentation": [".pptx"],
        "application/vnd.ms-powerpoint": [".ppt"],
        "text/csv": [".csv"],
        "text/plain": [".txt", ".md"],
        "application/zip": [".zip"],
        "video/mp4": [".mp4"],
        "video/quicktime": [".mov"],
        "application/octet-stream": [
          ".dxf", ".dwg", ".step", ".stp", ".iges", ".igs",
          ".stl", ".3mf", ".x_t", ".x_b", ".sat",
          ".sldprt", ".sldasm", ".slddrw", ".ipt", ".iam", ".idw",
          ".prt", ".catpart", ".catproduct", ".f3d"
        ]
      }
    }
  ],
  "share_target": {
    "action": "/whatsno/app/save.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "files", "accept": ["*/*"] }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "ファイルを保存",
      "short_name": "保存",
      "description": "ファイルや資料をWhat'sNoに直接保存",
      "url": "/whatsno/app/save.html?source=shortcut",
      "icons": [
        { "src": "/whatsno/assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }
      ]
    }
  ]
}
