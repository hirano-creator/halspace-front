{
  "name": "tenq",
  "private": true,
  "description": "TENQ — Smart Inspection System",
  "workspaces": [
    "shared",
    "api",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "db:migrate:local": "npm run db:migrate:local -w api",
    "db:seed:local": "npm run db:seed:local -w api",
    "db:reset:local": "npm run db:reset:local -w api",
    "typecheck": "tsc -p shared --noEmit && tsc -p api --noEmit && tsc -p web --noEmit && tsc -p . --noEmit",
    "test": "npm run test -w shared && npm run test -w api",
    "test:e2e": "playwright test",
    "build": "npm run build -w web",
    "check:size": "node scripts/check-size.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
